<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>com.novavms.mobile</ApplicationId>
    <ApplicationTitle>NovaVMS</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <PublishTrimmed>false</PublishTrimmed>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NovaVMS.Mobile/NovaVMS.Mobile.csproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.5" />
    <Compile Include="../NovaVMS.Mobile/Native/IVideoRenderer.cs" Link="Native/IVideoRenderer.cs" />
    <Compile Include="../NovaVMS.Mobile/Native/OverlayBackground.cs" Link="Native/OverlayBackground.cs" />
    <Compile Include="../NovaVMS.Mobile/Native/SystemVideoPlayer.cs" Link="Native/SystemVideoPlayer.cs" />
    <Compile Include="../NovaVMS.Mobile/Native/ClippedVideoView.cs" Link="Native/ClippedVideoView.cs" />
  </ItemGroup>
</Project>
