<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Set ReleaseDate explicitly for each release; rebuilding it keeps the same version. -->
    <ReleaseDate Condition="'$(ReleaseDate)' == ''">2026.10.23</ReleaseDate>
    <Version>$(ReleaseDate)</Version>
    <AssemblyVersion>$(ReleaseDate).0</AssemblyVersion>
    <FileVersion>$(ReleaseDate).0</FileVersion>
    <InformationalVersion>$(ReleaseDate)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>NovaVMS</Company>
    <Product>NovaVMS</Product>
  </PropertyGroup>
</Project>
