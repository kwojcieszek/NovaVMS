<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Platform video player is compiled by the Android and iOS heads against native LibVLC bindings. -->
    <Compile Remove="Native/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <ProjectReference Include="../NovaVMS.Core/NovaVMS.Core.csproj" />
    <ProjectReference Include="../NovaVMS.Infrastructure/NovaVMS.Infrastructure.csproj" />
    <ProjectReference Include="../NovaVMS.Protocols/NovaVMS.Protocols.csproj" />
  </ItemGroup>
</Project>
