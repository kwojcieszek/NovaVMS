<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NovaVMS.Mobile.Localization"
             xmlns:vm="using:NovaVMS.Mobile.ViewModels"
             xmlns:views="using:NovaVMS.Mobile.Views"
             x:Class="NovaVMS.Mobile.Views.CameraView"
             xmlns:controls="using:NovaVMS.Mobile.Controls"
             x:DataType="vm:CameraViewModel">

  <UserControl.Styles>
    <Style Selector="Border.bar">
      <Setter Property="Background" Value="#B3131416" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
    </Style>
    <Style Selector="Border.bar TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.mode">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4DFFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.mode.active">
      <Setter Property="Background" Value="{DynamicResource NovaAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource NovaAccent}" />
    </Style>
    <Style Selector="Button.mode:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#4DFFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.mode.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource NovaAccent}" />
    </Style>
    <Style Selector="Button.glass">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="Button.glass:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.glass:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.glass:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#59FFFFFF" />
    </Style>
    <Style Selector="Button.glass.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#33FFFFFF" />
    </Style>
    <Style Selector="Border.sheet">
      <Setter Property="Background" Value="#E6131416" />
      <Setter Property="BorderBrush" Value="#26FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="Button.glass PathIcon">
      <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="Layout" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*" Margin="{Binding LayoutInsets}">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="16,12" IsVisible="{Binding IsWindowed}">
      <StackPanel Spacing="2">
        <TextBlock Classes="pageTitle" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <PathIcon Grid.Column="1"
                Classes="connecting"
                Data="{StaticResource IconConnecting}"
                Width="24"
                Height="24"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding IsConnecting}"
                AutomationProperties.Name="{l:Tr Mobile_Connecting}" />
    </Grid>

    <!-- Video height follows the available size (see code-behind); a double tap switches full screen, where it fills
         the space between the bars. The native video stays in this one place, so switching never recreates it -->
    <Border x:Name="VideoArea" Grid.Row="1" Grid.ColumnSpan="2" Classes="tile" Height="220" PointerReleased="OnVideoPointerReleased">
      <ContentControl Content="{Binding Video}" />
    </Border>

    <ScrollViewer Grid.Row="2" Grid.ColumnSpan="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsWindowed}">
      <StackPanel Classes="page">
        <Button Classes="action"
                Content="{l:Tr Mobile_BackToCameras}"
                AutomationProperties.Name="{l:Tr Mobile_BackToCameras}"
                Command="{Binding BackCommand}" />
        <Button Classes="action primary"
                Content="{l:Tr Mobile_Reconnect}"
                AutomationProperties.Name="{l:Tr Mobile_Reconnect}"
                Command="{Binding ReconnectCommand}" />
        <CheckBox Content="{l:Tr Mobile_Sound}" IsChecked="{Binding SoundEnabled}" IsVisible="{Binding CanPlaySound}" />
        <Button Classes="action"
                Content="{l:Tr Mobile_PauseResume}"
                AutomationProperties.Name="{l:Tr Mobile_PauseResume}"
                Command="{Binding TogglePauseCommand}" />
        <Button Classes="action"
                Content="{l:Tr Mobile_StopStream}"
                AutomationProperties.Name="{l:Tr Mobile_StopStream}"
                Command="{Binding StopStreamCommand}" />
        <Button Classes="action"
                Content="{l:Tr Mobile_ToggleFavorite}"
                AutomationProperties.Name="{l:Tr Mobile_ToggleFavorite}"
                Command="{Binding ToggleFavoriteCommand}" />

        <Expander Header="{l:Tr Mobile_PtzControl}" HorizontalAlignment="Stretch">
          <views:PtzPanel DataContext="{Binding Ptz}" />
        </Expander>
        <Expander Header="{l:Tr Mobile_Recordings}" HorizontalAlignment="Stretch">
          <views:RecordingsPanel DataContext="{Binding Recordings}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <!-- Full screen the menu bars are placed above and below the picture, never over it: native video is drawn above
         Avalonia content and a second Avalonia layer over the picture was not transparent on iOS. The bar of the
         recordings is shown only while recordings are played; the calendar opens beside the picture. -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Classes="bar" IsVisible="{Binding IsFullScreenMenuVisible}" BorderThickness="0,0,0,1" Padding="6,6,12,6">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Grid.Column="0"
                Classes="glass"
                AutomationProperties.Name="{l:Tr Mobile_Back}"
                Command="{Binding BackCommand}">
          <PathIcon Data="{StaticResource IconChevronLeft}" Width="28" Height="28" />
        </Button>
        <StackPanel Grid.Column="1" Margin="4,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <PathIcon Classes="connecting"
                      Data="{StaticResource IconConnecting}"
                      Width="14"
                      Height="14"
                      IsVisible="{Binding IsConnecting}"
                      AutomationProperties.Name="{l:Tr Mobile_Connecting}" />
            <TextBlock Text="{Binding ModeText}" Opacity="0.8" FontSize="13" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="mode"
                  Classes.active="{Binding IsLive}"
                  Content="{l:Tr Mobile_Live}"
                  AutomationProperties.Name="{l:Tr Mobile_Live}"
                  Command="{Binding ShowLiveCommand}" />
          <Button Classes="mode"
                  Classes.active="{Binding IsPlayback}"
                  Content="{l:Tr Mobile_Recordings}"
                  AutomationProperties.Name="{l:Tr Mobile_Recordings}"
                  Command="{Binding ShowRecordingsCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ThemeVariantScope Grid.Row="1"
                       Grid.RowSpan="2"
                       IsVisible="{Binding IsFullScreen}"
                       Grid.Column="0"
                       RequestedThemeVariant="Dark"
                       VerticalAlignment="Center">
      <Border Classes="sheet"
              Margin="0,8,8,8"
              DataContext="{Binding Recordings}"
              x:DataType="vm:RecordingsViewModel"
              IsVisible="{Binding IsCalendarOpen}">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
          <Calendar Background="Transparent"
                    BorderThickness="0"
                    SelectedDate="{Binding SelectedDate}"
                    DisplayDate="{Binding Day, Mode=OneWay}"
                    DisplayDateEnd="{Binding Today}"
                    AutomationProperties.Name="{l:Tr Mobile_ChooseDay}" />
        </Viewbox>
      </Border>
    </ThemeVariantScope>

    <Panel Grid.Row="3" Grid.ColumnSpan="2" IsVisible="{Binding IsFullScreenTimelineVisible}">
      <Border Classes="bar"
              BorderThickness="0,1,0,0"
              Padding="8,4,12,8"
              DataContext="{Binding Recordings}"
              x:DataType="vm:RecordingsViewModel">
        <Grid ColumnDefinitions="Auto,Auto,Auto,*" RowDefinitions="Auto">
          <Button Grid.Column="0"
                  Classes="glass"
                  AutomationProperties.Name="{l:Tr Mobile_PreviousDay}"
                  Command="{Binding PreviousDayCommand}">
            <PathIcon Data="{StaticResource IconChevronLeft}" Width="24" Height="24" />
          </Button>
          <Button Grid.Column="1"
                  Classes="glass"
                  Classes.active="{Binding IsCalendarOpen}"
                  MinWidth="120"
                  Padding="10,6"
                  AutomationProperties.Name="{l:Tr Mobile_ChooseDay}"
                  Command="{Binding ToggleCalendarCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconCalendar}" Width="18" Height="18" />
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" Text="{Binding DayText}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2"
                  Classes="glass"
                  AutomationProperties.Name="{l:Tr Mobile_NextDay}"
                  Command="{Binding NextDayCommand}">
            <PathIcon Data="{StaticResource IconChevronRight}" Width="24" Height="24" />
          </Button>
          <controls:RecordingTimeline Grid.Column="3"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      Day="{Binding Day}"
                                      Segments="{Binding Segments}"
                                      Position="{Binding Position}"
                                      Command="{Binding PlayAtCommand}"
                                      TrackBrush="#33FFFFFF"
                                      SegmentBrush="{DynamicResource NovaAccent}"
                                      CursorBrush="White"
                                      Foreground="White"
                                      AutomationProperties.Name="{l:Tr Mobile_RecordingTimeline}" />
        </Grid>
      </Border>
    </Panel>
  </Grid>
</UserControl>
