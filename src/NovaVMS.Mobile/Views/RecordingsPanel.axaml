<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NovaVMS.Mobile.Localization"
             xmlns:controls="using:NovaVMS.Mobile.Controls"
             xmlns:vm="using:NovaVMS.Mobile.ViewModels"
             x:Class="NovaVMS.Mobile.Views.RecordingsPanel"
             x:DataType="vm:RecordingsViewModel">

  <StackPanel Spacing="10">
    <TextBlock Classes="muted" Text="{l:Tr Mobile_RecordingsHint}" TextWrapping="Wrap" />

    <!-- Day: one tap to the neighbouring day; a tap on the date opens the calendar for any other -->
    <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Grid.Column="0"
              Classes="icon"
              AutomationProperties.Name="{l:Tr Mobile_PreviousDay}"
              Command="{Binding PreviousDayCommand}">
        <PathIcon Data="{StaticResource IconChevronLeft}" Width="24" Height="24" />
      </Button>
      <Button Grid.Column="1"
              Classes="action"
              Margin="4,0"
              AutomationProperties.Name="{l:Tr Mobile_ChooseDay}"
              Command="{Binding ToggleCalendarCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <PathIcon Data="{StaticResource IconCalendar}" Width="18" Height="18" />
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding DayText}" />
        </StackPanel>
      </Button>
      <Button Grid.Column="2"
              Classes="icon"
              AutomationProperties.Name="{l:Tr Mobile_NextDay}"
              Command="{Binding NextDayCommand}">
        <PathIcon Data="{StaticResource IconChevronRight}" Width="24" Height="24" />
      </Button>
    </Grid>

    <!-- Shown in the page instead of a pop-up, which the native video above the page could cover -->
    <Border Classes="card" Padding="6" HorizontalAlignment="Center" IsVisible="{Binding IsCalendarOpen}">
      <Calendar Background="Transparent"
                BorderThickness="0"
                SelectedDate="{Binding SelectedDate}"
                DisplayDate="{Binding Day, Mode=OneWay}"
                DisplayDateEnd="{Binding Today}"
                AutomationProperties.Name="{l:Tr Mobile_ChooseDay}" />
    </Border>

    <!-- The 24 hours of the day; a tap on the bar plays from that time -->
    <Border Classes="card" Padding="10,6,10,8">
      <controls:RecordingTimeline Day="{Binding Day}"
                                  Segments="{Binding Segments}"
                                  Position="{Binding Position}"
                                  Command="{Binding PlayAtCommand}"
                                  TrackBrush="{DynamicResource NovaTileBorder}"
                                  SegmentBrush="{DynamicResource NovaAccent}"
                                  CursorBrush="{DynamicResource NovaStrongText}"
                                  Foreground="{DynamicResource NovaMutedText}"
                                  AutomationProperties.Name="{l:Tr Mobile_RecordingTimeline}" />
    </Border>

    <Button Classes="action primary"
            Content="{l:Tr Mobile_SearchRecordings}"
            AutomationProperties.Name="{l:Tr Mobile_SearchRecordings}"
            Command="{Binding SearchCommand}" />

    <ItemsControl ItemsSource="{Binding Results}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="vm:RecordingItemViewModel">
          <Button Classes="action"
                  Content="{Binding Title}"
                  AutomationProperties.Name="{Binding Title}"
                  Command="{Binding PlayCommand}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
