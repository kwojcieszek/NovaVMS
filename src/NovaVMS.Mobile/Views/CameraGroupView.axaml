<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NovaVMS.Mobile.Localization"
             xmlns:controls="using:NovaVMS.Mobile.Controls"
             xmlns:models="using:NovaVMS.Mobile.Models"
             xmlns:vm="using:NovaVMS.Mobile.ViewModels"
             x:Class="NovaVMS.Mobile.Views.CameraGroupView"
             x:DataType="vm:CameraGroupViewModel">

  <UserControl.Styles>
    <!-- Automatically every preview fits on the screen; a chosen number per row scrolls vertically -->
    <Style Selector="ScrollViewer.previews">
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="ScrollViewer.previews.scrollable">
      <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Compact header, so the previews get as much of the screen as possible -->
    <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,2,4,2">
      <TextBlock Classes="sectionTitle" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      <!-- Native video is drawn above the drop-down list, so the previews stop while it is open -->
      <ComboBox Grid.Column="1"
                Margin="4,0"
                DropDownOpened="OnColumnsDropDownOpened"
                DropDownClosed="OnColumnsDropDownClosed"
                SelectionChanged="OnColumnsSelectionChanged"
                VerticalAlignment="Center"
                ItemsSource="{Binding ColumnOptions}"
                SelectedItem="{Binding Columns}"
                AutomationProperties.Name="{l:Tr Mobile_ChangePreviewColumns}"
                ToolTip.Tip="{l:Tr Mobile_ChangePreviewColumns}">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate x:DataType="models:PreviewColumnsOption">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{StaticResource IconGrid}" Width="18" Height="18" />
              <TextBlock Text="{Binding ShortLabel}" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:PreviewColumnsOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Grid.Column="2"
              Classes="icon"
              AutomationProperties.Name="{l:Tr Mobile_ToggleTitles}"
              ToolTip.Tip="{l:Tr Mobile_ToggleTitles}"
              Command="{Binding ToggleTitlesCommand}">
        <Panel>
          <PathIcon Data="{StaticResource IconEye}" Width="22" Height="22" IsVisible="{Binding ShowTitles}" />
          <PathIcon Data="{StaticResource IconEyeOff}" Width="22" Height="22" IsVisible="{Binding !ShowTitles}" />
        </Panel>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1" Classes="muted" Margin="16" Text="{l:Tr Mobile_GroupEmpty}" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" />

    <!-- Tapping a tile opens the camera; the video views are clipped to this list while it scrolls -->
    <Border Grid.Row="1" Background="{DynamicResource NovaTileBackground}">
      <ScrollViewer Classes="previews" Classes.scrollable="{Binding IsScrollable}">
        <ItemsControl ItemsSource="{Binding Tiles}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <controls:VideoTileGrid Columns="{Binding Columns.Value}" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:CameraTileViewModel">
              <Button Classes="tile"
                      AutomationProperties.Name="{Binding AutomationName}"
                      Command="{Binding OpenCommand}">
                <!-- Native video is drawn above Avalonia content, so the name is a strip below the picture, not an overlay -->
                <Grid RowDefinitions="*,Auto">
                  <Border Classes="preview">
                    <Panel>
                      <ContentControl Content="{Binding Video}" />
                      <TextBlock Classes="overlay" Text="{Binding State}" />
                    </Panel>
                  </Border>
                  <Border Grid.Row="1"
                          Classes="tileTitle"
                          IsVisible="{Binding $parent[ItemsControl].((vm:CameraGroupViewModel)DataContext).ShowTitles}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <PathIcon Classes="favorite" Data="{StaticResource IconStar}" Width="12" Height="12" IsVisible="{Binding IsFavorite}" />
                      <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" Foreground="#FFE6E6E6" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
