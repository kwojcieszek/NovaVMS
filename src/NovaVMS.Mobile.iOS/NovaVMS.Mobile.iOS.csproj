<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.novavms.mobile</ApplicationId>
    <ApplicationTitle>NovaVMS</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">ios-arm64</RuntimeIdentifier>
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- Every assembly is AOT compiled; the interpreter only runs code generated at runtime.
         Interpreting all code made rendering, connections and stream reading slow on the phone. -->
    <UseInterpreter>true</UseInterpreter>
    <MtouchInterpreter>-all</MtouchInterpreter>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NovaVMS.Mobile/NovaVMS.Mobile.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.5" />
    <Compile Include="../NovaVMS.Mobile/Native/IVideoRenderer.cs" Link="Native/IVideoRenderer.cs" />
    <Compile Include="../NovaVMS.Mobile/Native/SystemVideoPlayer.cs" Link="Native/SystemVideoPlayer.cs" />
    <Compile Include="../NovaVMS.Mobile/Native/ClippedVideoView.iOS.cs" Link="Native/ClippedVideoView.iOS.cs" />
    <BundleResource Include="PrivacyInfo.xcprivacy" />
  </ItemGroup>
</Project>
