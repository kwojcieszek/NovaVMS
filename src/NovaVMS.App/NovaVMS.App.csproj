<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NovaVMS</AssemblyName>
    <RootNamespace>NovaVMS.App</RootNamespace>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\novavms.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Target platform: the runtime identifier when one is given (e.g. dotnet publish -r osx-arm64),
       otherwise the build host. This lets a Windows machine produce a complete macOS build. -->
  <PropertyGroup>
    <NovaTargetsWindows Condition="$(RuntimeIdentifier.StartsWith('win')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</NovaTargetsWindows>
    <NovaTargetsMacOS Condition="$(RuntimeIdentifier.StartsWith('osx')) Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</NovaTargetsMacOS>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <!-- 3.0.0 is the last version built for Avalonia 11 (3.0.1+ targets Avalonia 12). -->
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <!-- Native LibVLC binaries for the target platform. The macOS package contains osx-arm64 and osx-x64
       builds and copies the one matching the runtime identifier to libvlc/<rid>.
       On Linux LibVLC comes from the system packages (e.g. apt install vlc libvlc-dev). -->
  <ItemGroup Condition="'$(NovaTargetsWindows)' == 'true'">
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup Condition="'$(NovaTargetsMacOS)' == 'true'">
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaVMS.Core\NovaVMS.Core.csproj" />
    <ProjectReference Include="..\NovaVMS.Protocols\NovaVMS.Protocols.csproj" />
    <ProjectReference Include="..\NovaVMS.Infrastructure\NovaVMS.Infrastructure.csproj" />
  </ItemGroup>

</Project>
