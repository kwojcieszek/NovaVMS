<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NovaVMS.App.Localization"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:NovaVMS.App.ViewModels"
        xmlns:pm="using:NovaVMS.Presentation.Models"
        xmlns:views="using:NovaVMS.App.Views"
        x:Class="NovaVMS.App.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        Title="{l:Tr Settings_Title}"
        Width="1320" Height="820"
        MinWidth="1080" MinHeight="640"
        Icon="/Assets/novavms.ico"
        WindowStartupLocation="CenterOwner"
		WindowState="Maximized"
        Background="{DynamicResource NovaWindowBackground}">

  <DockPanel>
    <TabControl x:Name="Pages" Margin="8" TabStripPlacement="Top">
      <TabItem IsVisible="{Binding Session.CanEditGeneralSettings}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="TuneVariant" FontSize="16" Text="{l:Tr Settings_General}" />
        </TabItem.Header>
        <views:GeneralSettingsView DataContext="{Binding General}" />
      </TabItem>
      <TabItem IsVisible="{Binding Session.CanEditGroups}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="FolderStarMultipleOutline" FontSize="16" Text="{l:Tr Settings_Groups}" />
        </TabItem.Header>
        <views:GroupsSettingsView DataContext="{Binding Groups}" />
      </TabItem>
      <TabItem IsVisible="{Binding Session.CanEditDevices}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="Server" FontSize="16" Text="{l:Tr Settings_Devices}" />
        </TabItem.Header>
        <views:DevicesSettingsView DataContext="{Binding Devices}" />
      </TabItem>
      <TabItem IsVisible="{Binding Session.CanEditUsers}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="AccountMultipleOutline" FontSize="16" Text="{l:Tr Settings_Users}" />
        </TabItem.Header>
        <views:UsersSettingsView DataContext="{Binding Users}" />
      </TabItem>
      <TabItem IsVisible="{Binding Session.CanEditSettingsSync}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="DatabaseSyncOutline" FontSize="16" Text="{l:Tr Settings_Sync}" />
        </TabItem.Header>
        <views:SyncSettingsView DataContext="{Binding Sync}" />
      </TabItem>
      <TabItem IsVisible="{Binding Session.CanEditGeneralSettings}">
        <TabItem.Header>
          <mi:MaterialIconText Kind="FileDocumentOutline" FontSize="16" Text="{l:Tr Settings_Log}" />
        </TabItem.Header>
        <Grid x:DataType="vm:ApplicationLogViewModel" DataContext="{Binding Log, DataType=vm:SettingsWindowViewModel}"
              Loaded="OnLogLoaded" RowDefinitions="Auto,Auto,*,Auto" Margin="12">
          <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Command="{Binding ClearCommand}" Content="{l:Tr Log_Clear}" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}" Content="{l:Tr Sync_Refresh}" />
            <TextBlock Text="{Binding FilePath}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Grid.Row="1" Text="{Binding Status}" IsVisible="{Binding !!Status}" Margin="0,0,0,8" />
          <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                    CanUserResizeColumns="True" ScrollViewer.AllowAutoHide="False">
            <DataGrid.Columns>
              <DataGridTextColumn x:DataType="pm:ApplicationLogEntry" Header="{l:Tr Log_Timestamp}" Binding="{Binding Timestamp}" Width="Auto" />
              <DataGridTextColumn x:DataType="pm:ApplicationLogEntry" Header="{l:Tr Log_ProcessId}" Binding="{Binding ProcessId}" Width="Auto" />
              <DataGridTextColumn x:DataType="pm:ApplicationLogEntry" Header="{l:Tr Log_ThreadId}" Binding="{Binding ThreadId}" Width="Auto" />
              <DataGridTextColumn x:DataType="pm:ApplicationLogEntry" Header="{l:Tr Log_Source}" Binding="{Binding Source}" Width="2*" />
              <DataGridTextColumn x:DataType="pm:ApplicationLogEntry" Header="{l:Tr Log_Summary}" Binding="{Binding Summary}" Width="3*" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBox Grid.Row="3" Text="{Binding SelectedEntry.FullText, Mode=OneWay}" IsVisible="{Binding !!SelectedEntry}"
                   Height="160" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Consolas,monospace"
                   AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="NoWrap"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
