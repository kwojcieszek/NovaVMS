<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaVMS.App.ViewModels"
             xmlns:l="using:NovaVMS.App.Localization"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="NovaVMS.App.Views.VideoTileView"
             x:DataType="vm:VideoTileViewModel">

  <Border Classes="tile" Classes.selected="{Binding IsSelected}">
    <DockPanel>
      <Button x:Name="HeaderButton"
              DockPanel.Dock="Top"
              Classes="tileHeader"
              DragDrop.AllowDrop="True"
              IsVisible="{Binding ShowTitle}"
              Command="{Binding SelectCommand}"
              ToolTip.Tip="{Binding ErrorDetails}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right"
                     Classes="muted"
                     Classes.error="{Binding HasError}"
                     Text="{Binding StatusText}"
                     Margin="8,0,0,0" />
          <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Button>

      <!-- On Windows both native surfaces stay mapped at full size. Prepare the next stream behind
           the live picture and swap native stacking order only after its first frames are rendered. -->
      <Panel x:Name="VideoHost">
        <!-- Both players share one stable tile overlay. Stream handovers never show another window. -->
        <vlc:VideoView x:Name="Video" MediaPlayer="{Binding PrimaryPlayer}" IsVisible="{Binding IsPrimaryViewVisible}" />
        <vlc:VideoView x:Name="SecondaryVideo" MediaPlayer="{Binding SecondaryPlayer}" IsVisible="{Binding IsSecondaryViewVisible}" />
        <!-- Moved into the tile's owned overlay window by the view constructor. -->
        <Panel x:Name="VideoOverlay" Background="#01000000" DragDrop.AllowDrop="True">
          <Border Background="Black" IsVisible="{Binding IsVideoCovered}" IsHitTestVisible="False" />
          <Path Classes="loadingSpinner" Data="M 12,2 A 10,10 0 1 1 2,12"
                Width="24" Height="24" Stretch="Uniform" Stroke="#BFFFFFFF" StrokeThickness="2"
                StrokeLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"
                RenderTransformOrigin="50%,50%" IsHitTestVisible="False"
                IsVisible="{Binding IsLoading}" AutomationProperties.Name="{l:Tr Tile_Connecting}">
            <Path.Styles>
              <Style Selector="Path.loadingSpinner">
                <Style.Animations>
                  <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Path.Styles>
          </Path>
          <TextBlock Classes="overlayText"
                     Text="{Binding OverlayText}"
                     IsVisible="{Binding IsOverlayTextVisible}" />
        </Panel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
