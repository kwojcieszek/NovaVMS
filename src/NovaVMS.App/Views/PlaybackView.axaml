<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NovaVMS.App.Localization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:NovaVMS.App.ViewModels"
             xmlns:models="using:NovaVMS.App.Models"
             xmlns:controls="using:NovaVMS.App.Controls"
             xmlns:views="using:NovaVMS.App.Views"
             x:Class="NovaVMS.App.Views.PlaybackView"
             x:DataType="vm:PlaybackWorkspaceViewModel">

  <DockPanel>

    <Border DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource NovaPanelBackground}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <mi:MaterialIcon Kind="ViewGridOutline" VerticalAlignment="Center" />
        <TextBlock Text="{l:Tr Playback_CameraCount}" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding CameraCounts}" SelectedItem="{Binding SelectedCameraCount}" MinWidth="78" />
        <Button Command="{Binding ResetWindowsCommand}">
          <mi:MaterialIconText Kind="Restore" Text="{l:Tr Playback_ResetWindows}" />
        </Button>
        <TextBlock Text="{l:Tr Playback_MultipleHint}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Day and time range -->
    <Border DockPanel.Dock="Top" Padding="12,8" Background="{DynamicResource NovaPanelBackground}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
          <CalendarDatePicker SelectedDate="{Binding SelectedDate}" Width="150" ToolTip.Tip="{l:Tr Playback_DayTip}" />
          <mi:MaterialIcon Kind="ClockOutline" VerticalAlignment="Center" />
          <TextBlock Classes="muted" Text="{l:Tr Playback_From}" VerticalAlignment="Center" />
          <TimePicker SelectedTime="{Binding FromTime}" ClockIdentifier="24HourClock" MinWidth="0" Width="130" />
          <TextBlock Classes="muted" Text="{l:Tr Playback_To}" VerticalAlignment="Center" />
          <TimePicker SelectedTime="{Binding ToTime}" ClockIdentifier="24HourClock" MinWidth="0" Width="130" />
          <Button Classes="icon"
                  Command="{Binding ResetTimeRangeCommand}"
                  ToolTip.Tip="{l:Tr Playback_WholeDayTip}"
                  Content="{mi:MaterialIconExt Kind=Restore}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <mi:MaterialIcon Kind="Cctv" Width="18" Height="18" />
          <TextBlock Text="{Binding CameraName}"
                     FontSize="15" FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Timeline and transport controls -->
    <Border DockPanel.Dock="Bottom" Padding="12,8" Background="{DynamicResource NovaPanelBackground}">
      <StackPanel Spacing="8">
        <controls:TimelineBar Height="48"
                              Cursor="Hand"
                              Day="{Binding Day}"
                              Segments="{Binding Segments}"
                              Position="{Binding TimelinePosition}"
                              RangeStart="{Binding RangeStartSeconds}"
                              RangeEnd="{Binding RangeEndSeconds}"
                              IsInteracting="{Binding IsSeeking}"
                              SeekCommand="{Binding SeekCommand}" />
        <DockPanel>
          <TextBlock DockPanel.Dock="Right"
                     Classes="muted"
                     VerticalAlignment="Center"
                     Text="{Binding StatusText}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding SeekCommand}" CommandParameter="{Binding TimelinePosition}"
                    IsVisible="{Binding !IsPlaying}" ToolTip.Tip="{l:Tr Playback_Play}"
                    Content="{mi:MaterialIconExt Kind=Play}" />
            <Button Command="{Binding TogglePauseCommand}" ToolTip.Tip="{l:Tr Playback_PauseTip}">
              <Panel>
                <mi:MaterialIcon Kind="Pause" IsVisible="{Binding !IsPaused}" />
                <mi:MaterialIcon Kind="Play" IsVisible="{Binding IsPaused}" />
              </Panel>
            </Button>
            <Button Command="{Binding StopCommand}" ToolTip.Tip="{l:Tr Playback_StopTip}" Content="{mi:MaterialIconExt Kind=Stop}" />
            <TextBlock Text="{l:Tr Playback_Shuttle}" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding SelectedSpeed}" MinWidth="100"
                      ToolTip.Tip="{l:Tr Playback_ShuttleTip}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:PlaybackSpeedOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding NormalSpeedCommand}" Content="▶ 1×" ToolTip.Tip="{l:Tr Playback_NormalSpeed}" />
            <TextBlock Text="{Binding CurrentTimeText}"
                       FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="12,0" />
          </StackPanel>
        </DockPanel>
        <TextBlock Classes="muted"
                   FontSize="11"
                   Text="{l:Tr Playback_TimelineHint}" />
      </StackPanel>
    </Border>

    <!-- Recording export -->
    <Border DockPanel.Dock="Right"
            Background="{DynamicResource NovaPanelBackground}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8">
          <TextBlock Classes="sectionTitle" Text="{l:Tr Playback_Export}" Margin="4,0,8,0"
                     VerticalAlignment="Center" IsVisible="{Binding IsExportPanelExpanded}" />
          <ToggleButton Grid.Column="1" IsChecked="{Binding IsExportPanelExpanded, Mode=TwoWay}"
                        ToolTip.Tip="{l:Tr Playback_Export}"
                        AutomationProperties.Name="{l:Tr Playback_Export}">
            <Panel>
              <mi:MaterialIcon Kind="ChevronRight" IsVisible="{Binding IsExportPanelExpanded}" />
              <mi:MaterialIcon Kind="ChevronLeft" IsVisible="{Binding !IsExportPanelExpanded}" />
            </Panel>
          </ToggleButton>
        </Grid>
        <StackPanel VerticalAlignment="Top" Width="266" Spacing="8" Margin="12"
                    IsVisible="{Binding IsExportPanelExpanded}">
          <TextBlock Text="{l:Tr Playback_ExportCameras}" FontWeight="SemiBold" />
          <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Tiles}" IsEnabled="{Binding !IsExporting}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaybackTileViewModel">
                  <CheckBox IsChecked="{Binding IsExportSelected, Mode=TwoWay}" IsVisible="{Binding Playback.HasCamera}"
                            Content="{Binding Header}" ToolTip.Tip="{Binding Playback.CameraName}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Classes="muted" Text="{l:Tr Playback_ExportFrom}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <CalendarDatePicker SelectedDate="{Binding ExportFromDate}" Width="145" />
            <TextBox Text="{Binding ExportFromText}" Width="105" Watermark="HH:mm:ss" />
          </StackPanel>
          <Button Command="{Binding MarkExportStartCommand}" Content="{l:Tr Playback_MarkFrom}" />
          <TextBlock Classes="muted" Text="{l:Tr Playback_ExportTo}" />
          <StackPanel Orientation="Horizontal" Spacing="4">
            <CalendarDatePicker SelectedDate="{Binding ExportToDate}" Width="145" />
            <TextBox Text="{Binding ExportToText}" Width="105" Watermark="HH:mm:ss" />
          </StackPanel>
          <Button Command="{Binding MarkExportEndCommand}" Content="{l:Tr Playback_MarkTo}" />
          <TextBlock Classes="muted" Text="{l:Tr Playback_ExportHint}" TextWrapping="Wrap" FontSize="11" />
          <Button Classes="accent" Command="{Binding ExportCommand}">
            <mi:MaterialIconText Kind="Download" Text="{l:Tr Playback_ExportMp4}" />
          </Button>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ExportProgress}" IsVisible="{Binding IsExporting}" />
          <Button Command="{Binding CancelExportCommand}" IsVisible="{Binding IsExporting}" Content="{l:Tr Playback_CancelExport}" />
          <TextBlock Text="{Binding ExportStatus}" TextWrapping="Wrap" FontSize="11" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Background="{DynamicResource NovaTileBackground}" Margin="1">
      <ItemsControl x:Name="VideoHost" ItemsSource="{Binding Tiles}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid x:DataType="vm:PlaybackWorkspaceViewModel" Columns="{Binding Columns}" Rows="{Binding Rows}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PlaybackTileViewModel"><views:PlaybackTileView /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

  </DockPanel>
</UserControl>
