<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:NovaVMS.App.Models"
        x:Class="NovaVMS.App.Views.BusyWindow"
        Title="NovaVMS"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="/Assets/novavms.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource NovaPanelBackground}">

  <StackPanel Margin="24,20" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Image Source="/Assets/novavms.png" Width="32" Height="32" />
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" />
        <TextBlock Classes="muted" FontSize="11" Text="{x:Static models:ApplicationVersion.DisplayName}" />
      </StackPanel>
    </StackPanel>
    <TextBlock x:Name="MessageText" Classes="muted" TextWrapping="Wrap" />
    <ProgressBar IsIndeterminate="True" Height="6" />
  </StackPanel>
</Window>
