<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NovaVMS.App.Localization"
        x:Class="NovaVMS.App.Views.ShutdownWindow"
        Title="NovaVMS"
        Width="380"
        SizeToContent="Height"
        CanResize="False"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="False"
        Topmost="True"
        Icon="/Assets/novavms.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NovaPanelBackground}">

  <StackPanel Margin="24,20" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Image Source="/Assets/novavms.png" Width="28" Height="28" />
      <TextBlock Text="{l:Tr Shutdown_Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="muted" TextWrapping="Wrap" Text="{l:Tr Shutdown_Message}" />
    <ProgressBar IsIndeterminate="True" Height="6" />
  </StackPanel>
</Window>
