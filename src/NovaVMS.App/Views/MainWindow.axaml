<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NovaVMS.App.Localization"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:NovaVMS.App.ViewModels"
        xmlns:views="using:NovaVMS.App.Views"
        xmlns:models="using:NovaVMS.App.Models"
        x:Class="NovaVMS.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{x:Static models:ApplicationVersion.DisplayName}"
        Width="1440" Height="900"
        MinWidth="1000" MinHeight="640"
        Icon="/Assets/novavms.ico"
        WindowStartupLocation="CenterScreen"
		WindowState="Maximized"
        Background="{DynamicResource NovaWindowBackground}">

  <!-- Nothing is shown until a user is logged in. -->
  <DockPanel IsVisible="{Binding Session.IsLoggedIn}">

    <!-- Header: view tabs, theme, user and settings -->
    <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource NovaHeaderBackground}"
            IsVisible="{Binding !Live.IsVideoOnly}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0">
          <Button Classes="icon"
                  Command="{Binding CycleThemeCommand}"
                  IsVisible="{Binding Session.CanEditGeneralSettings}"
                  ToolTip.Tip="{l:Tr App_ThemeToggleTip}"
                  Content="{mi:MaterialIconExt Kind=ThemeLightDark}" />
          <Button Classes="toolbar" VerticalAlignment="Center">
            <mi:MaterialIconText Kind="AccountCircleOutline" Text="{Binding Session.UserName}" />
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="{l:Tr Login_AutoLoginMenu}" Command="{Binding ToggleAutoLoginCommand}">
                  <MenuItem.Icon>
                    <Panel>
                      <mi:MaterialIcon Kind="CheckboxMarkedOutline" IsVisible="{Binding Session.IsAutoLogin}" />
                      <mi:MaterialIcon Kind="CheckboxBlankOutline" IsVisible="{Binding !Session.IsAutoLogin}" />
                    </Panel>
                  </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{l:Tr Login_Logout}" Icon="{mi:MaterialIconExt Kind=Logout}" Command="{Binding LogoutCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Classes="toolbar"
                  VerticalAlignment="Center"
                  IsVisible="{Binding Session.CanOpenSettings}"
                  Click="OnSettingsClick">
            <mi:MaterialIconText Kind="CogOutline" Text="{l:Tr App_Settings}" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="14,0,18,0" VerticalAlignment="Center">
            <Image Source="/Assets/novavms.png" Width="28" Height="28" Stretch="Uniform" />
            <TextBlock Text="NovaVMS" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="{x:Static models:ApplicationVersion.Number}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="tab"
                  Classes.active="{Binding IsLivePage}"
                  Command="{Binding ShowLiveCommand}">
            <mi:MaterialIconText Kind="Video" Text="{l:Tr App_LiveView}" />
          </Button>
          <Button Classes="tab"
                  Classes.active="{Binding IsPlaybackPage}"
                  IsVisible="{Binding Session.CanPlayback}"
                  Command="{Binding ShowPlaybackCommand}">
            <mi:MaterialIconText Kind="History" Text="{l:Tr App_Playback}" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Top" Padding="12,6" Background="{DynamicResource NovaPanelBackground}">
      <Border.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="Updates.HasUpdate" />
          <Binding Path="!Live.IsVideoOnly" />
        </MultiBinding>
      </Border.IsVisible>
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="accent" Command="{Binding Updates.InstallCommand}" Content="{l:Tr Updates_Install}" />
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding Updates.AvailableText}" />
          <TextBlock Classes="muted" Text="{Binding Updates.StatusText}" FontSize="11" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="12,4" Background="{DynamicResource NovaHeaderBackground}"
            IsVisible="{Binding !Live.IsVideoOnly}">
      <TextBlock Classes="muted" FontSize="12" Text="{Binding StatusBar.Message}" />
    </Border>

    <!-- In the camera-only mode the code-behind collapses the resource panel column. -->
    <Grid x:Name="MainGrid" ColumnDefinitions="290,4,*">

      <!-- Resource panel -->
      <DockPanel Grid.Column="0" Background="{DynamicResource NovaPanelBackground}"
                 IsVisible="{Binding !Live.IsVideoOnly}">
        <Expander DockPanel.Dock="Bottom"
                  HorizontalAlignment="Stretch"
                  CornerRadius="0">
          <Expander.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsLivePage" />
              <Binding Path="Session.CanControlPtz" />
            </MultiBinding>
          </Expander.IsVisible>
          <Expander.Header>
            <mi:MaterialIconText Kind="CameraControl" Text="{l:Tr App_PtzControl}" />
          </Expander.Header>
          <views:PtzPanel DataContext="{Binding Ptz}" />
        </Expander>

        <DockPanel DockPanel.Dock="Top" Margin="10,10,6,6">
          <Button DockPanel.Dock="Right"
                  Classes="icon"
                  Margin="4,0,0,0"
                  Command="{Binding Tree.ToggleSearchCommand}"
                  ToolTip.Tip="{l:Tr Tree_ToggleSearchTip}">
            <Panel>
              <mi:MaterialIcon Kind="MagnifyMinusOutline" IsVisible="{Binding Tree.IsSearchVisible}" />
              <mi:MaterialIcon Kind="Magnify" IsVisible="{Binding !Tree.IsSearchVisible}" />
            </Panel>
          </Button>
          <Panel>
            <TextBox Watermark="{l:Tr Tree_SearchWatermark}"
                     Text="{Binding Tree.SearchText}"
                     IsVisible="{Binding Tree.IsSearchVisible}" />
            <TextBlock Text="{l:Tr Tree_Cameras}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       IsVisible="{Binding !Tree.IsSearchVisible}" />
          </Panel>
        </DockPanel>

        <TreeView x:Name="ResourceTree"
                  ItemsSource="{Binding Tree.Groups}"
                  AutoScrollToSelectedItem="False"
                  SelectedItem="{Binding Tree.SelectedNode, Mode=TwoWay}"
                  Tapped="OnTreeTapped">
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:ResourceNodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.DataTemplates>
            <TreeDataTemplate DataType="vm:ResourceGroupNodeViewModel"
                              x:DataType="vm:ResourceGroupNodeViewModel"
                              ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Spacing="8" Background="Transparent">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{l:Tr Tree_OpenAll}" IsVisible="{Binding !IsViewsFolder}"
                              Icon="{mi:MaterialIconExt Kind=ViewGridOutline}"
                              Command="{Binding Owner.OpenNodeCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{l:Tr Tree_ResetGroupView}" IsVisible="{Binding IsCameraGroup}"
                              Icon="{mi:MaterialIconExt Kind=Restore}"
                              Command="{Binding Owner.ResetGroupViewCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{l:Tr Tree_Rename}"
                              Icon="{mi:MaterialIconExt Kind=PencilOutline}"
                              Command="{Binding Owner.RenameViewCommand}"
                              CommandParameter="{Binding}">
                      <MenuItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsSavedView" />
                          <Binding Path="Owner.Session.CanEditViews" />
                        </MultiBinding>
                      </MenuItem.IsVisible>
                    </MenuItem>
                    <MenuItem Header="{l:Tr Views_AddNew}"
                              Icon="{mi:MaterialIconExt Kind=ViewGridPlusOutline}"
                              Command="{Binding Owner.RequestNewViewCommand}">
                      <MenuItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsViewsFolder" />
                          <Binding Path="Owner.Session.CanEditViews" />
                        </MultiBinding>
                      </MenuItem.IsVisible>
                    </MenuItem>
                    <MenuItem Header="{l:Tr Views_Delete}"
                              Icon="{mi:MaterialIconExt Kind=DeleteOutline}"
                              Command="{Binding Owner.DeleteViewCommand}" CommandParameter="{Binding}">
                      <MenuItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="IsSavedView" />
                          <Binding Path="Owner.Session.CanEditViews" />
                        </MultiBinding>
                      </MenuItem.IsVisible>
                    </MenuItem>
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <mi:MaterialIcon Kind="ViewDashboard" Foreground="{DynamicResource NovaViewIcon}" IsVisible="{Binding IsViewsFolder}" />
                <mi:MaterialIcon Kind="ViewGridOutline" Foreground="{DynamicResource NovaViewIcon}" IsVisible="{Binding IsSavedView}" />
                <mi:MaterialIcon Kind="FolderStar" Foreground="{DynamicResource NovaAccent}" IsVisible="{Binding IsCustom}" />
                <mi:MaterialIcon Kind="Server" IsVisible="{Binding IsDeviceGroup}" />
                <mi:MaterialIcon Kind="Star" Foreground="{DynamicResource NovaFavoriteIcon}" IsVisible="{Binding IsFavorites}" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </TreeDataTemplate>
            <DataTemplate DataType="vm:CameraNodeViewModel" x:DataType="vm:CameraNodeViewModel">
              <StackPanel Orientation="Horizontal"
                          Spacing="8"
                          Background="Transparent"
                          Classes.offline="{Binding !IsOnline}"
                          ToolTip.Tip="{Binding FullName}">
                <StackPanel.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{l:Tr Tree_OpenInLiveView}"
                              Icon="{mi:MaterialIconExt Kind=PlayCircleOutline}"
                              Command="{Binding Owner.OpenNodeCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{Binding FavoriteActionText}"
                              Icon="{mi:MaterialIconExt Kind=StarOutline}"
                              IsVisible="{Binding Owner.Session.CanEditFavorites}"
                              Command="{Binding Owner.ToggleFavoriteCommand}"
                              CommandParameter="{Binding}" />
                    <MenuItem Header="{l:Tr Views_RemoveCamera}"
                              Icon="{mi:MaterialIconExt Kind=Close}"
                              Command="{Binding Owner.RemoveFromViewCommand}"
                              CommandParameter="{Binding}">
                      <MenuItem.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="CanRemoveFromView" />
                          <Binding Path="Owner.Session.CanEditViews" />
                        </MultiBinding>
                      </MenuItem.IsVisible>
                    </MenuItem>
                  </ContextMenu>
                </StackPanel.ContextMenu>
                <Button Classes="icon"
                        Padding="2"
                        Width="22" Height="22"
                        Focusable="False"
                        IsEnabled="{Binding Owner.Session.CanEditFavorites}"
                        Command="{Binding Owner.ToggleFavoriteCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding FavoriteActionText}">
                  <Panel>
                    <mi:MaterialIcon Kind="Star" Foreground="{DynamicResource NovaFavoriteIcon}" IsVisible="{Binding IsFavorite}" />
                    <mi:MaterialIcon Kind="StarOutline" IsVisible="{Binding !IsFavorite}" />
                  </Panel>
                </Button>
                <mi:MaterialIcon Kind="Cctv" Classes="status" Classes.online="{Binding IsOnline}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </TreeView.DataTemplates>
        </TreeView>
      </DockPanel>

      <GridSplitter Grid.Column="1"
                    ResizeDirection="Columns"
                    IsVisible="{Binding !Live.IsVideoOnly}"
                    Background="{DynamicResource NovaHeaderBackground}" />

      <!-- Main views -->
      <Panel Grid.Column="2">
        <Panel IsVisible="{Binding IsLivePage}">
          <views:LiveView DataContext="{Binding Live}" />
        </Panel>
        <Panel IsVisible="{Binding IsPlaybackPage}">
          <views:PlaybackView DataContext="{Binding Playback}" />
        </Panel>
      </Panel>

    </Grid>
  </DockPanel>
</Window>
