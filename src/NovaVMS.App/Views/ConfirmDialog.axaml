<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:NovaVMS.App.Localization"
        xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="NovaVMS.App.Views.ConfirmDialog"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        Icon="/Assets/novavms.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource NovaWindowBackground}">

  <StackPanel Margin="16" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <mi:MaterialIcon Kind="HelpCircleOutline" Width="28" Height="28" VerticalAlignment="Top" />
      <TextBlock x:Name="MessageText" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Classes="accent"
              IsDefault="True"
              MinWidth="90"
              Click="OnYesClick"
              Content="{l:Tr Common_Yes}" />
      <Button IsCancel="True"
              MinWidth="90"
              Click="OnNoClick"
              Content="{l:Tr Common_No}" />
    </StackPanel>
  </StackPanel>
</Window>
