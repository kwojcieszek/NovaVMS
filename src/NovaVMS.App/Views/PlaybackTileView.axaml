<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:NovaVMS.App.Localization"
             xmlns:mi="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:NovaVMS.App.ViewModels"
             xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
             x:Class="NovaVMS.App.Views.PlaybackTileView"
             x:DataType="vm:PlaybackTileViewModel">
  <Border Classes="tile" Classes.selected="{Binding IsSelected}">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
        <Button Classes="tileHeader" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch"
                ToolTip.Tip="{Binding Playback.StatusText}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Classes="muted" Text="{Binding Playback.CurrentTimeText}" Margin="8,0" />
            <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Button>
        <Button Grid.Column="1" Classes="icon" Command="{Binding CloseCommand}"
                IsVisible="{Binding Playback.HasCamera}" ToolTip.Tip="{l:Tr Live_CloseTile}"
                Content="{mi:MaterialIconExt Kind=Close}" />
      </Grid>
      <DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Playback.StatusText}" Classes="muted"
                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="6,2" />
        <Grid>
          <Button Command="{Binding SelectCommand}" IsVisible="{Binding !Playback.HasCamera}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock Text="{l:Tr Playback_EmptyTile}" TextWrapping="Wrap" HorizontalAlignment="Center" />
          </Button>
          <Panel x:Name="VideoHost" IsVisible="{Binding Playback.HasCamera}">
            <vlc:VideoView x:Name="PrimaryVideo" MediaPlayer="{Binding Playback.PrimaryPlayer}" />
            <vlc:VideoView x:Name="SecondaryVideo" MediaPlayer="{Binding Playback.SecondaryPlayer}" />
          </Panel>
        </Grid>
      </DockPanel>
    </DockPanel>
  </Border>
</UserControl>
